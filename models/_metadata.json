{
    "definitions": [
      {
        "title": "Metadata Block",
        "id": "metadata",
        "plugins": {
          "xwalk": {
            "page": {
              "resourceType": "core/franklin/components/block/v1/block",
              "template": {
                "name": "Metadata",
                "filter": "metadata-items"
              }
            }
          }
        }
      },
      {
        "title": "Metadata Row Item",
        "id": "metadata-item",
        "plugins": {
          "xwalk": {
            "page": {
              "resourceType": "core/franklin/components/block/v1/block/item",
              "template": {
                "name": "Row",
                "model": "metadata-row-model"
              }
            }
          }
        }
      }
    ],
    "models": [
      {
        "id": "metadata-row-model",
        "fields": [
          {
            "component": "text-input",
            "name": "metaKey",
            "label": "Property Key (e.g., og:type, robots)",
            "valueType": "string",
            "required": true
          },
          {
            "component": "text-input",
            "name": "metaValue",
            "label": "Property Value",
            "valueType": "string",
            "required": true
          }
        ]
      }
    ],
    "filters": [
      {
        "id": "metadata-items",
        "components": [ "metadata-item" ]
      }
    ]
  }
  